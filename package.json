{
  "name": "noveltracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/server",
    "app/client",
    "app/tests"
  ],
  "scripts": {
    "dev:server": "npm --workspace app/server run dev",
    "dev:client": "npm --workspace app/client run dev",
    "test:api": "npm --workspace app/tests run test:api",
    "test:e2e": "npm --workspace app/tests run test:e2e",
    "migrate": "npm --workspace app/server run migrate"
  }
}
