{
  "name": "noveltracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "tests"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "test:api": "npm --workspace tests run test:api",
    "test:e2e": "npm --workspace tests run test:e2e",
    "migrate": "npm --workspace server run migrate"
  }
}
