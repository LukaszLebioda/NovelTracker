            },
            "description": "@req:auth#REQ-009 — a wrong password is rejected with 401 invalid_credentials and the exact generic message; no cookie is set. Stores the body for the REQ-010 deep-equal check."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
