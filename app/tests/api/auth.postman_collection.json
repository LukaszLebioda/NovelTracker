    {
      "name": "auth/login-logout",
      "description": "POST /api/auth/login, GET /api/auth/me and POST /api/auth/logout — login-logout.design.md. Login failures are indistinguishable (anti-enumeration).",
      "item": [
        {
          "name": "GET /me without a session cookie — 401 unauthenticated (REQ-008)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "@req:auth#REQ-008 — /me is the UI state source; with no cookie it reports an anonymous user. Runs before any login so the cookie jar is empty."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().clear(pm.request.url.toString(), function () {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401 (REQ-008)', function () { pm.response.to.have.status(401); });",
                  "pm.test('error code is unauthenticated', function () { pm.response.to.have.jsonBody('error.code', 'unauthenticated'); });",
                  "pm.test('error message is verbatim', function () { pm.response.to.have.jsonBody('error.message', 'You are not signed in.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login success — 200 and a session cookie (REQ-008)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"reader@example.com\",\"password\":\"correct-horse\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "@req:auth#REQ-008 — correct credentials return 200 with the account, set an httpOnly session cookie, and never expose password material."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/auth/register',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'reader@example.com', password: 'correct-horse' }) }",
                  "}, function () {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 OK (REQ-008)', function () { pm.response.to.have.status(200); });",
                  "pm.test('body returns the canonical lowercased account (REQ-007)', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.id).to.be.a('string').and.to.not.be.empty;",
                  "  pm.expect(body.user.email).to.eql('reader@example.com');",
                  "});",
                  "pm.test('no password material in the response', function () {",
                  "  pm.expect(JSON.stringify(pm.response.json())).to.not.include('password');",
                  "});",
                  "pm.test('a session cookie is set with HttpOnly and SameSite (REQ-008)', function () {",
                  "  const cookies = pm.response.headers.all().filter(function (h) { return /^set-cookie$/i.test(h.key); }).map(function (h) { return h.value; }).join('; ');",
                  "  pm.expect(cookies).to.match(/nt_session=/);",
                  "  pm.expect(cookies).to.match(/HttpOnly/i);",
                  "  pm.expect(cookies).to.match(/SameSite/i);",
                  "  const m = /nt_session=([^;]+)/.exec(cookies);",
                  "  if (m) { pm.collectionVariables.set('sessionToken', m[1].trim()); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /me with a session cookie — 200 (REQ-008)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
