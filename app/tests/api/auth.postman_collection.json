              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401 (REQ-009)', function () { pm.response.to.have.status(401); });",
                  "pm.test('error code is invalid_credentials (REQ-009)', function () { pm.response.to.have.jsonBody('error.code', 'invalid_credentials'); });",
                  "pm.test('error message is the exact generic string (REQ-009)', function () { pm.response.to.have.jsonBody('error.message', 'The email or password is invalid.'); });",
