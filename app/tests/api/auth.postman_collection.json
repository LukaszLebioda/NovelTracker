        {
          "name": "Logout success — 204, clears cookie, old cookie is dead (REQ-011)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "@req:auth#REQ-011 — logging out of the active session (cookie jar from the login folder) returns 204, clears the cookie, and the old cookie is rejected afterwards."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let token = null;",
                  "try { token = pm.cookies.get('nt_session'); } catch (e) { token = null; }",
                  "pm.collectionVariables.set('logoutToken', token || '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204 No Content (REQ-011)', function () { pm.response.to.have.status(204); });",
                  "pm.test('body is empty (REQ-011)', function () { pm.expect(pm.response.text()).to.eql(''); });",
                  "pm.test('the session cookie is cleared (REQ-011)', function () {",
                  "  const cookies = pm.response.headers.all().filter(function (h) { return /^set-cookie$/i.test(h.key); }).map(function (h) { return h.value; }).join('; ');",
                  "  pm.expect(cookies).to.match(/nt_session=/);",
                  "});",
                  "const token = pm.collectionVariables.get('logoutToken');",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/auth/me',",
                  "  method: 'GET',",
                  "  header: token ? { 'Cookie': 'nt_session=' + token } : {}",
                  "}, function (err, res) {",
                  "  pm.test('the old session cookie is now rejected (REQ-011)', function () {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res.code).to.eql(401);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
