{
  "info": {
    "name": "NovelTracker Auth API",
    "description": "API scenarios for the auth domain (register, login, logout). One request per API scenario from spec/features/auth/register.design.md and spec/features/auth/login-logout.design.md. Each request carries its @req:auth#REQ-nnn tag in the name or description. Run after a DB reset; register folder runs first so a fresh users table is required for the 201 cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "auth/register",
      "description": "POST /api/auth/register — register.design.md. Errors use the envelope { error: { code, message } }.",
      "item": [
        {
          "name": "Register success — 201 for a new email (REQ-001)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"Reader@Example.com\",\"password\":\"correct-horse\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "@req:auth#REQ-001 — a valid new email returns 201 with the canonical (trimmed, lowercased) email, sets no session cookie, and never returns password material. Requires a fresh/empty users table."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 Created (REQ-001)', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('body returns the account with the canonical lowercased email (REQ-007)', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('user');",
                  "  pm.expect(body.user.id).to.be.a('string').and.to.not.be.empty;",
                  "  pm.expect(body.user.email).to.eql('reader@example.com');",
                  "});",
                  "pm.test('response never exposes password material', function () {",
                  "  pm.expect(JSON.stringify(pm.response.json())).to.not.include('password');",
                  "});",
                  "pm.test('registration does not sign the user in: no Set-Cookie (REQ-001)', function () {",
                  "  const cookies = pm.response.headers.all().filter(function (h) { return /^set-cookie$/i.test(h.key); });",
                  "  pm.expect(cookies).to.have.length(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate (same casing) — 409 email_taken (REQ-002)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"reader@example.com\",\"password\":\"another-pass-123\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "@req:auth#REQ-002 — registering an email that already has an account is rejected with 409 email_taken and does not create or overwrite a second account."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/auth/register',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'reader@example.com', password: 'correct-horse' }) }",
                  "}, function () {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409 Conflict (REQ-002)', function () { pm.response.to.have.status(409); });",
                  "pm.test('error code is email_taken (REQ-002)', function () { pm.response.to.have.jsonBody('error.code', 'email_taken'); });",
                  "pm.test('error message is verbatim (REQ-002)', function () { pm.response.to.have.jsonBody('error.message', 'The email is already registered.'); });",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'reader@example.com', password: 'correct-horse' }) }",
                  "}, function (err, res) {",
                  "  pm.test('the original account survives: the correct password still logs in (REQ-002)', function () {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res.code).to.eql(200);",
                  "  });",
                  "});",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'reader@example.com', password: 'another-pass-123' }) }",
                  "}, function (err, res) {",
                  "  pm.test('the duplicate attempt did not overwrite the account: the new password is rejected (REQ-002)', function () {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(res.code).to.eql(401);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
