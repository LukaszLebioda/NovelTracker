# Build context: app/ (the product root). Build from the repository root with:
#   docker build -f app/docker/Dockerfile.client -t noveltracker-client app
FROM node:20-alpine

WORKDIR /app

COPY client/package.json ./
RUN npm install

COPY client/ ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
